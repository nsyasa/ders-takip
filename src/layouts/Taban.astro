---
import '../styles/yazi-tipleri.css';
import '../styles/tema.css';
import '../styles/bilesenler.css';
import '../styles/sevimli.css';
import '../styles/yazdir.css';
import Direnc from '../components/Direnc.astro';
import SevimliSemboller from '../components/SevimliSemboller.astro';
import { yol } from '../lib/veri';
// Sayfada görünen yazı tipleri (gövde + mono etiketler) çizimden önce yüklensin: yazı tipi gelince sayfa kaymasın.
import atkinson from '../assets/fonts/atkinson-hyperlegible-next-latin-wght-normal.woff2?url';
import atkinsonExt from '../assets/fonts/atkinson-hyperlegible-next-latin-ext-wght-normal.woff2?url';
import mono from '../assets/fonts/jetbrains-mono-latin-wght-normal.woff2?url';
import monoExt from '../assets/fonts/jetbrains-mono-latin-ext-wght-normal.woff2?url';
// Fredoka (başlıklar) yalnız "sevimli" temalı derslerde yüklenir
import fredoka from '../assets/fonts/fredoka-latin-wght-normal.woff2?url';
import fredokaExt from '../assets/fonts/fredoka-latin-ext-wght-normal.woff2?url';

interface Props {
  baslik?: string;
  aciklama?: string;
  aktif?: 'ana' | 'verilerim' | 'ara';
  /** Dar (okuma sütunu) sayfalarda üst çubuk ve alt bilgi de aynı genişliğe hizalanır */
  dar?: boolean;
  /** Dersin teması (ders.json): "sevimli" sayfalar renkli, çocuk dostu görünür */
  tema?: 'okunur' | 'sevimli';
}

const {
  baslik,
  aciklama = 'Öğrenciler için reklamsız ders takip sitesi. İlerlemen yalnız bu cihazda saklanır.',
  aktif,
  dar = false,
  tema = 'okunur',
} = Astro.props;
const sevimli = tema === 'sevimli';
const tamBaslik = baslik ? `${baslik} · Ders Takip` : 'Ders Takip';
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tamBaslik}</title>
    <meta name="description" content={aciklama} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={yol('favicon.svg')} />
    <link rel="preload" as="font" type="font/woff2" href={atkinson} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={atkinsonExt} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={mono} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={monoExt} crossorigin="anonymous" />
    {sevimli && <link rel="preload" as="font" type="font/woff2" href={fredoka} crossorigin="anonymous" />}
    {sevimli && <link rel="preload" as="font" type="font/woff2" href={fredokaExt} crossorigin="anonymous" />}
    <!-- Tema, sayfa çizilmeden önce uygulanır (yanıp sönmeyi önler). -->
    <script is:inline>
      try {
        var t = localStorage.getItem('ders-takip:tema');
        if (t === 'koyu' || t === 'acik') document.documentElement.dataset.tema = t;
      } catch (e) {}
    </script>
  </head>
  <body class:list={{ sevimli }}>
    {sevimli && <SevimliSemboller />}
    <a class="atla" href="#icerik">İçeriğe geç</a>
    <header class="ust">
      <div class:list={['kap', 'ust-ic', { dar }]}>
        <a class="logo" href={yol('/')}>
          <Direnc numara={12} boyut="kucuk" />
          <span>Ders Takip</span>
        </a>
        <button class="dugme dugme-duz tema-dugme" type="button" data-tema-dugme aria-pressed="false" hidden>Koyu mod</button>
        <nav class="ust-nav" aria-label="Ana menü">
          <ul class="menu">
            <li><a href={yol('/')} aria-current={aktif === 'ana' ? 'page' : undefined}>Derslerim</a></li>
            <li><a href={yol('/verilerim/')} aria-current={aktif === 'verilerim' ? 'page' : undefined}>Verilerim</a></li>
            <li>
              <a href={yol('/ara/')} aria-current={aktif === 'ara' ? 'page' : undefined}>Ara</a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="icerik" tabindex="-1">
      <slot />
    </main>

    <footer class="alt">
      <div class:list={['kap', { dar }]}>
        <p>Bu sitede reklam, çerez ve izleme yoktur. İlerlemen ve yazdıkların yalnız bu cihazda saklanır.</p>
        <p><a href={yol('/verilerim/')}>Başka cihazda devam etmek için yedeğini al</a></p>
      </div>
    </footer>

    <script>
      // Koyu mod düğmesi: yalnız JS varsa görünür.
      const dugme = document.querySelector<HTMLButtonElement>('[data-tema-dugme]');
      if (dugme) {
        const koyuMu = () => {
          const t = document.documentElement.dataset.tema;
          return t ? t === 'koyu' : matchMedia('(prefers-color-scheme: dark)').matches;
        };
        const guncelle = () => dugme.setAttribute('aria-pressed', String(koyuMu()));
        dugme.hidden = false;
        guncelle();
        dugme.addEventListener('click', () => {
          const yeni = koyuMu() ? 'acik' : 'koyu';
          document.documentElement.dataset.tema = yeni;
          try {
            localStorage.setItem('ders-takip:tema', yeni);
          } catch {
            /* depolama yok */
          }
          guncelle();
        });
        matchMedia('(prefers-color-scheme: dark)').addEventListener('change', guncelle);
      }
    </script>
  </body>
</html>
