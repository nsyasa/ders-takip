---
import Taban from '../../layouts/Taban.astro';
import FoySatiri from '../../components/FoySatiri.astro';
import ProjeKarti from '../../components/ProjeKarti.astro';
import Ilerleme from '../../components/Ilerleme.astro';
import LedPanel from '../../components/LedPanel.astro';
import Bit from '../../components/Bit.astro';
import { tumDersler, dersFoyleri, dersGenel, foyKimligi, foyYolu, sureMetni, yol, sozluk, sevimliMi, uniteGrupla } from '../../lib/veri';
import { kapakBilgisi } from '../../lib/kapak';

export async function getStaticPaths() {
  const dersler = (await tumDersler()).filter((d) => d.data.durum === 'hazir');
  return Promise.all(
    dersler.map(async (ders) => ({
      params: { ders: ders.id },
      props: { ders, foyler: await dersFoyleri(ders.id), genel: await dersGenel(ders) },
    })),
  );
}

const { ders, foyler, genel } = Astro.props;
const d = ders.data;
const s = sozluk(ders);
const sevimli = sevimliMi(ders);
const toplamDk = foyler.reduce((t, f) => t + f.data.sureDk, 0);
const adimHaritasi = (liste: typeof foyler) => JSON.stringify(Object.fromEntries(liste.map((f) => [foyKimligi(f), f.data.adimSayisi])));
const adimlar = adimHaritasi(foyler);
const gruplar = uniteGrupla(ders, foyler);
const iki = (n: number) => String(n).padStart(2, '0');

// Kapak çizimleri (sevimli): kaymasın diye en-boy oranı dosyadan okunur
const kapak = sevimli ? kapakBilgisi(ders.id, d.kapak) : null;
const kapak2 = sevimli ? kapakBilgisi(ders.id, d.kapak2) : null;
const ilkFoy = foyler[0];
---

<Taban baslik={d.ad} aciklama={d.aciklama} tema={d.tema}>
  <div class="kap" style={`--renk:${d.renk}`}>
    <nav class="ekmek" aria-label="Sayfa yolu">
      <ol>
        <li><a href={yol('/')}>Derslerim</a></li>
        <li aria-current="page">{d.ad}</li>
      </ol>
    </nav>

    {
      sevimli ? (
        <header class="ders-baslik ders-kahraman" data-ders-ilerleme={ders.id} data-adimlar={adimlar} data-birim={s.kucuk}>
          <div class="kahraman-yazi">
            <h1>{d.ad}</h1>
            <p class="ders-alt">{d.altbaslik}</p>
            <p class="kahraman-aciklama">{d.aciklama}</p>
            <div class="bit-selam">
              <Bit yuz="mutlu" sinif="bit-selam-resim" />
              <p>Merhaba, ben Bit! Her projede seninle birlikte kodlayacağım.</p>
            </div>
            {d.adimEtiketleri.length > 0 && (
              <ol class="adim-yolu" aria-label="Her projede bu altı adımı izlersin">
                {d.adimEtiketleri.map((a) => (
                  <li>{a.ad}</li>
                ))}
              </ol>
            )}
          </div>
          {kapak && (
            <div class="kahraman-resim-kap">
              <img
                class="kahraman-resim"
                src={kapak.src}
                srcset={kapak.srcset}
                sizes="(min-width: 52rem) 480px, calc(100vw - 2.5rem)"
                alt={d.kapakAlt}
                width={kapak.width}
                height={kapak.height}
                decoding="async"
                fetchpriority="high"
              />
              <span class="kahraman-etiket" aria-hidden="true">
                <strong>{foyler.length}</strong>
                <small>{s.kucuk}</small>
              </span>
            </div>
          )}
          <div class="kahraman-ilerleme">
            <LedPanel kimlikler={foyler.map(foyKimligi)} sinif="led-panel-buyuk" />
            <div class="kahraman-metin">
              <p class="ilerleme-metni" data-ilerleme-metin>
                0 / {foyler.length} {s.kucuk} bitti
              </p>
              <p class="ders-meta">
                {foyler.length} {s.kucuk} · yaklaşık {sureMetni(toplamDk)}
              </p>
              <p class="kahraman-ipucu">Her proje bitince bir LED yanar.</p>
            </div>
          </div>
        </header>
      ) : (
        <header class="ders-baslik" data-ders-ilerleme={ders.id} data-adimlar={adimlar} data-birim={s.kucuk}>
          <h1>{d.ad}</h1>
          <p class="ders-alt">{d.altbaslik}</p>
          <p>{d.aciklama}</p>
          <p class="ders-meta">
            {foyler.length} {s.kucuk} · yaklaşık {sureMetni(toplamDk)}
          </p>
          <Ilerleme etiket={`${d.ad} ilerlemesi`} metin={`0 / ${foyler.length} ${s.kucuk} bitti`} />
        </header>
      )
    }

    {
      sevimli && gruplar.length > 0 ? (
        gruplar.map((g, i) => (
          <section
            class="unite"
            aria-labelledby={`unite-${i}`}
            style={g.renk ? `--unite:${g.renk}` : undefined}
            data-ders-ilerleme={`${ders.id}-unite-${i}`}
            data-adimlar={adimHaritasi(g.foyler)}
            data-birim={s.kucuk}
          >
            <h2 id={`unite-${i}`} class="unite-baslik">
              <span class="unite-aralik">
                {iki(g.ilk)}–{iki(g.son)}
              </span>
              {g.ad}
            </h2>
            <p class="ilerleme-metni unite-metin" data-ilerleme-metin>
              0 / {g.foyler.length} {s.kucuk} bitti
            </p>
            <ol class="proje-izgara">
              {g.foyler.map((f) => (
                <ProjeKarti foy={f} s={s} />
              ))}
            </ol>
          </section>
        ))
      ) : (
        <section aria-labelledby="foyler-baslik">
          <h2 id="foyler-baslik">{s.liste}</h2>
          <ol class="foy-listesi">
            {foyler.map((f) => (
              <FoySatiri foy={f} s={s} />
            ))}
          </ol>
        </section>
      )
    }

    {
      sevimli && kapak2 && ilkFoy && (
        <aside class="kapanis" aria-label="Başla">
          <img
            class="kapanis-resim"
            src={kapak2.src}
            srcset={kapak2.srcset}
            sizes="(min-width: 52rem) 420px, calc(100vw - 2.5rem)"
            alt={d.kapak2Alt}
            width={kapak2.width}
            height={kapak2.height}
            loading="lazy"
            decoding="async"
          />
          <div class="kapanis-yazi">
            {d.slogan && <p class="kapanis-slogan">{d.slogan}</p>}
            <p>Bak, tahmin et, kodla, dene, anlat, değiştir. Küçük bir fikirle başla.</p>
            <a class="dugme dugme-sari" href={foyYolu(ilkFoy)}>İlk projeyi aç →</a>
          </div>
        </aside>
      )
    }

    {
      genel.length > 0 && (
        <section aria-labelledby="genel-baslik">
          <h2 id="genel-baslik">Genel bilgiler</h2>
          <ul class="genel-liste">
            {genel.map((g) => (
              <li>
                <a href={yol(`/${ders.id}/genel/${g.data.slug}/`)}>{g.data.baslik}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Taban>

<script>
  import '../../scripts/ilerleme-goster';
</script>
