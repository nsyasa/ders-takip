---
import { render } from 'astro:content';
import Taban from '../../../layouts/Taban.astro';
import { tumDersler, dersGenel, yol, sevimliMi, type Ders, type Genel } from '../../../lib/veri';

export async function getStaticPaths() {
  const dersler = (await tumDersler()).filter((d) => d.data.durum === 'hazir');
  const sonuc: { params: { ders: string; slug: string }; props: { ders: Ders; sayfa: Genel } }[] = [];
  for (const ders of dersler) {
    const sayfalar = await dersGenel(ders);
    for (const sayfa of sayfalar) {
      sonuc.push({ params: { ders: ders.id, slug: sayfa.data.slug }, props: { ders, sayfa } });
    }
  }
  return sonuc;
}

const { ders, sayfa } = Astro.props;
const { Content } = await render(sayfa);
---

<Taban baslik={sayfa.data.baslik} aciklama={`${ders.data.ad}: ${sayfa.data.baslik}`} dar tema={ders.data.tema}>
  <div class="kap dar" style={`--renk:${ders.data.renk}`}>
    <nav class="ekmek" aria-label="Sayfa yolu">
      <ol>
        <li><a href={yol('/')}>Derslerim</a></li>
        <li><a href={yol(`/${ders.id}/`)}>{ders.data.ad}</a></li>
        <li aria-current="page">{sayfa.data.baslik}</li>
      </ol>
    </nav>
    {/* Onay kutuları ve yazma alanları föylerdeki gibi bu cihazda saklanır (kimlik: <ders>/genel-<slug>) */}
    <article
      data-foy-kok
      data-genel
      data-foy={`${ders.id}/genel-${sayfa.data.slug}`}
      data-adim-toplam="0"
      data-baslik={sayfa.data.baslik}
      data-pagefind-body
      class:list={['genel-icerik', { 'genel-sevimli': sevimliMi(ders) }]}
    >
      {sayfa.data.ustbilgi && <p class="genel-ustbilgi">{sayfa.data.ustbilgi}</p>}
      <h1 data-pagefind-meta="title">{sayfa.data.baslik}</h1>
      <Content />
      <p class="depo-uyari" role="status" data-depo-uyari data-pagefind-ignore hidden>
        Bu tarayıcı kayıt tutmaya izin vermiyor (gizli sekme olabilir). Yazdıkların ve işaretlerin yalnız bu sayfa açıkken kalır.
      </p>
    </article>
    <p data-yazdirma-gizle><a href={yol(`/${ders.id}/`)}>← {ders.data.ad} sayfasına dön</a></p>
  </div>
</Taban>

<script>
  import '../../../scripts/foy';
</script>
