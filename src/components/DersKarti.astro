---
import type { Ders, Foy } from '../lib/veri';
import { sureMetni, yol, foyKimligi, sozluk, sevimliMi } from '../lib/veri';
import { kapakBilgisi } from '../lib/kapak';
import Ilerleme from './Ilerleme.astro';
import LedPanel from './LedPanel.astro';

interface Props {
  ders: Ders;
  foyler: Foy[];
  /** Ana sayfadaki bütün kartlar kapak çizimli mi? Öyleyse resimsiz bir ders de aynı yapıda (resim yeri boş) çizilir. */
  galeri?: boolean;
  /** Sayfanın ilk kartı: görseli ekranın üstünde olduğu için geç yüklenmez (LCP) */
  oncelik?: boolean;
}
const { ders, foyler, galeri = false, oncelik = false } = Astro.props;
const d = ders.data;
const hazir = d.durum === 'hazir';
const s = sozluk(ders);
const sevimli = sevimliMi(ders) && hazir;
const toplamDk = foyler.reduce((t, f) => t + f.data.sureDk, 0);
// Her föyün onay kutusu sayısı: ilerleme çizgisi bunlarla hesaplanır.
const adimlar = JSON.stringify(Object.fromEntries(foyler.map((f) => [foyKimligi(f), f.data.adimSayisi])));

// Kapak çizimi (ders.json > kapak): en-boy oranı korunur, sayfa yüklenirken kaymaz.
const kapak = kapakBilgisi(ders.id, d.kapak);
const resimli = Boolean(kapak) || galeri;
---

<li
  class:list={['ders-karti', { yakinda: !hazir, 'ders-karti-resimli': resimli, 'ders-karti-sevimli': sevimli }]}
  style={`--renk:${d.renk}`}
  data-ders-ilerleme={hazir ? ders.id : undefined}
  data-adimlar={hazir ? adimlar : undefined}
  data-birim={hazir ? s.kucuk : undefined}
>
  {
    resimli ? (
      <>
        <div class="kart-resim-kap">
          {kapak && (
            <img
              class="kart-resim"
              src={kapak.src}
              srcset={kapak.srcset}
              sizes="(min-width: 64rem) 330px, (min-width: 40rem) 45vw, calc(100vw - 2.5rem)"
              alt={d.kapakAlt}
              width={kapak.width}
              height={kapak.height}
              loading={oncelik ? 'eager' : 'lazy'}
              fetchpriority={oncelik ? 'high' : undefined}
              decoding="async"
            />
          )}
          {!hazir && <span class="rozet rozet-yakinda kart-yakinda">Yakında</span>}
        </div>
        <div class="ders-govde kart-govde">
          {d.etiketler.length > 0 && (
            <ul class="etiketler kart-etiketler" aria-label="Sınıf ve yaş">
              {d.etiketler.map((e) => (
                <li>{e}</li>
              ))}
            </ul>
          )}
          <h2>{hazir ? <a href={yol(`/${ders.id}/`)}>{d.ad}</a> : d.ad}</h2>
          {hazir && <p class="ders-alt">{d.altbaslik}</p>}
          <p class="ders-aciklama">{d.aciklama}</p>
          {hazir && (
            <div class="kart-ilerleme">
              {sevimli ? (
                <>
                  <LedPanel kimlikler={foyler.map(foyKimligi)} sinif="led-panel-kart" />
                  <p class="ders-meta kart-meta">
                    <strong data-ilerleme-metin>0 / {foyler.length} {s.kucuk} bitti</strong>
                    <span>
                      {foyler.length} {s.kucuk} · yaklaşık {sureMetni(toplamDk)}
                    </span>
                  </p>
                </>
              ) : (
                <div class="kart-cubuk">
                  <p class="ders-meta">
                    {foyler.length} {s.kucuk} · yaklaşık {sureMetni(toplamDk)}
                  </p>
                  <Ilerleme etiket={`${d.ad} ilerlemesi`} metin={`0 / ${foyler.length} ${s.kucuk} bitti`} />
                </div>
              )}
            </div>
          )}
        </div>
      </>
    ) : (
      <>
        <span class="ders-sira" aria-hidden="true">{String(d.sira).padStart(2, '0')}</span>
        <div class="ders-govde">
          <h2>
            {hazir ? <a href={yol(`/${ders.id}/`)}>{d.ad}</a> : d.ad}
          </h2>
          <p class="ders-alt">{hazir ? d.altbaslik : <span class="rozet rozet-yakinda">Yakında</span>}</p>
          <p class="ders-aciklama">{d.aciklama}</p>
          {hazir ? (
            <>
              <p class="ders-meta">
                {foyler.length} {s.kucuk} · yaklaşık {sureMetni(toplamDk)}
              </p>
              <Ilerleme etiket={`${d.ad} ilerlemesi`} metin={`0 / ${foyler.length} ${s.kucuk} bitti`} />
            </>
          ) : null}
        </div>
      </>
    )
  }
</li>
