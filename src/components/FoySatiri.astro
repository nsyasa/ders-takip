---
import type { Foy, Sozluk } from '../lib/veri';
import { foyKimligi, foyYolu, yol, FOY_SOZLUGU } from '../lib/veri';
import Direnc from './Direnc.astro';

interface Props {
  foy: Foy;
  s?: Sozluk;
}
const { foy, s = FOY_SOZLUGU } = Astro.props;
const d = foy.data;
---

<li class="foy-satir" data-foy-satiri={foyKimligi(foy)} data-adim={d.adimSayisi}>
  <div class="foy-sol" aria-hidden="true">
    <Direnc numara={d.numara} boyut="kucuk" />
    <span class="foy-no">{s.tek} {String(d.numara).padStart(2, '0')}</span>
    {d.simge && <img class="foy-satir-simge" src={yol(`/${d.ders}/gorseller/${d.simge}.webp`)} width="192" height="192" alt="" loading="lazy" decoding="async" />}
  </div>
  <div class="foy-sag">
    <h3 class="foy-baslik">
      <a class="foy-link" href={foyYolu(foy)}><span class="gorunmez">{s.tek} {d.numara}: </span>{d.baslik}</a>
    </h3>
    {d.altbaslik && <p class="foy-alt">{d.altbaslik}</p>}
    <p class="foy-meta">
      <span class="rozet rozet-baslamadi" data-durum-rozet>Başlamadı</span>
      <span>{d.sureDk} dk</span>
      {d.seviye && <span>{d.seviye}</span>}
    </p>
    {
      d.kavramlar.length > 0 && (
        <ul class="etiketler" aria-label="Kavramlar">
          {d.kavramlar.map((k) => (
            <li>{k}</li>
          ))}
        </ul>
      )
    }
  </div>
</li>
